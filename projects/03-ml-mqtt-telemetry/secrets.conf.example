# Copy this file to secrets.conf (same folder) and fill in your values.
# secrets.conf is git-ignored. Never commit it, and never share firmware built with it:
# the Wi-Fi password is stored inside the binary.
CONFIG_APP_WIFI_SSID="my-network"
CONFIG_APP_WIFI_PSK="my-password"
# Same number as the -k option that worked in the wifi shell (1 = WPA2-PSK)
CONFIG_APP_WIFI_SECURITY=1
# IPv4 address of the PC running Mosquitto (ipconfig on the PC)
CONFIG_APP_MQTT_BROKER_ADDR="192.168.1.100"
