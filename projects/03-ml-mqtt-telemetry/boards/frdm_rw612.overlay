/*
 * The P3T1755 temperature sensor on the FRDM-RW612 sits on FlexComm 2 (I2C),
 * GPIO_16 = SDA, GPIO_17 = SCL, 7-bit address 0x48 (board user manual UM12160, section 2.5).
 * Zephyr's board file already calls that bus "arduino_i2c".
 */
/ {
	aliases {
		ambient-temp0 = &p3t1755;
	};
};

&arduino_i2c {
	status = "okay";

	p3t1755: p3t1755@48 {
		compatible = "nxp,p3t1755";
		reg = <0x48>;
	};
};

/* Same as Zephyr's wifi shell sample for this board (Apache-2.0, NXP) */
&standby {
	status = "okay";
};
